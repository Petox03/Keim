{
  "name": "{{ .Name }} Dev",
  "dockerComposeFile": ["../compose.yml"],
  "service": "app",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go"
      ],
      "settings": {
        "go.gopath": "/root/go",
        "go.useLanguageServer": true
      }
    }
  }
}